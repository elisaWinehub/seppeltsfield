<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign is_journal = false
  if blog.handle == 'journal'
    assign is_journal = true
  endif
  assign journal_active_tag = ''
  assign journal_active_tag_handle = ''
  if current_tags != blank
    assign journal_active_tag = current_tags | first
    assign journal_active_tag_handle = journal_active_tag | handleize
  endif
%}

{% if is_journal %}
  <div class="journal-listing">
    {% render 'journal-listing-header',
      active_tag_label: journal_active_tag,
      active_tag_handle: journal_active_tag_handle,
      blog_url: blog.url
    %}

    {% paginate blog.articles by 10 %}
      {% assign show_featured_article = false %}
      {% if paginate.current_page == 1 %}
        {% assign show_featured_article = true %}
      {% endif %}
      {% assign featured_article = blog.articles.first %}
      {% if featured_article and show_featured_article %}
        <section class="journal-listing__feature">
          <div class="section">
            <a class="journal-feature" href="{{ featured_article.url }}">
              <div class="journal-feature__media">
                {% if featured_article.image %}
                  {{ featured_article.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: featured_article.title }}
                {% else %}
                  <div class="journal-image-placeholder" aria-hidden="true">
                    {% if settings.logo_inverse != blank %}
                      {{ settings.logo_inverse | image_url: width: 420 | image_tag: widths: '220,320,420', sizes: '220px', alt: shop.name, loading: 'lazy' }}
                    {% elsif settings.logo != blank %}
                      {{ settings.logo | image_url: width: 420 | image_tag: widths: '220,320,420', sizes: '220px', alt: shop.name, loading: 'lazy' }}
                    {% else %}
                      <img src="https://cdn.shopify.com/s/files/1/0780/2608/0408/files/Seppeltsfield-logo_Est1851_HERO_no_Background.png?v=1783903221" alt="{{ shop.name | escape }}" loading="lazy">
                    {% endif %}
                  </div>
                {% endif %}
                {% if featured_article.tags.size > 0 %}
                  <span class="journal-feature__tag">{{ featured_article.tags.first }}</span>
                {% endif %}
              </div>
              <div class="journal-feature__copy">
                <p class="journal-feature__eyebrow">Featured</p>
                <h2>{{ featured_article.title }}</h2>
                <p>{{ featured_article.excerpt_or_content | strip_html | truncate: 220 }}</p>
                <p class="journal-feature__meta">
                  <span>{{ featured_article.author }}</span>
                  <span>{{ featured_article.published_at | date: '%d %b %Y' }}</span>
                </p>
              </div>
            </a>
          </div>
        </section>
      {% endif %}

      <section class="journal-listing__grid-section" data-journal-listing data-section-id="{{ section.id }}">
        <div class="section">
          <div class="journal-listing__label">
            <h3>Latest from the Journal</h3>
            <span>{{ blog.articles_count }} articles</span>
          </div>
          <div class="journal-listing__grid" data-journal-grid>
            {% if show_featured_article %}
              {% assign listing_offset = 1 %}
            {% else %}
              {% assign listing_offset = 0 %}
            {% endif %}
            {% for article in blog.articles offset: listing_offset %}
              <a class="journal-card" href="{{ article.url }}">
                <div class="journal-card__media">
                  {% if article.image %}
                    {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: article.title }}
                  {% else %}
                    <div class="journal-image-placeholder" aria-hidden="true">
                      {% if settings.logo_inverse != blank %}
                        {{ settings.logo_inverse | image_url: width: 360 | image_tag: widths: '200,280,360', sizes: '(min-width: 750px) 33vw, 100vw', alt: shop.name, loading: 'lazy' }}
                      {% elsif settings.logo != blank %}
                        {{ settings.logo | image_url: width: 360 | image_tag: widths: '200,280,360', sizes: '(min-width: 750px) 33vw, 100vw', alt: shop.name, loading: 'lazy' }}
                      {% else %}
                        <img src="https://cdn.shopify.com/s/files/1/0780/2608/0408/files/Seppeltsfield-logo_Est1851_HERO_no_Background.png?v=1783903221" alt="{{ shop.name | escape }}" loading="lazy">
                      {% endif %}
                    </div>
                  {% endif %}
                  {% if article.tags.size > 0 %}
                    <span class="journal-card__tag">{{ article.tags.first }}</span>
                  {% endif %}
                </div>
                <div class="journal-card__body">
                  <h4>{{ article.title }}</h4>
                  <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
                  <p class="journal-card__meta">{{ article.author }} · {{ article.published_at | date: '%d %b %Y' }}</p>
                </div>
              </a>
            {% endfor %}
          </div>

          {% if paginate.next %}
            <div class="journal-listing__load-more" data-journal-load-more-wrap>
              <button
                type="button"
                data-journal-load-more
                data-next-url="{{ paginate.next.url }}"
                data-loading-label="Loading..."
              >
                Load more articles
              </button>
            </div>
          {% endif %}
        </div>
      </section>
    {% endpaginate %}

    <section class="journal-listing__signup">
      <div class="section journal-listing__signup-grid">
        <div>
          <p class="journal-listing__signup-eyebrow">Join the community</p>
          <h2 class="journal-listing__signup-title">Never miss a story.</h2>
          <p class="journal-listing__signup-copy">
            New recipes, estate news and winemaker notes, straight to your inbox.
          </p>
        </div>
        <div>
          {% form 'customer', class: 'journal-listing__signup-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="JournalNewsletterEmail-{{ section.id }}">Email</label>
            <input
              id="JournalNewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="Your email address"
              required
              autocomplete="email"
            >
            <button type="submit">Subscribe</button>
          {% endform %}
        </div>
      </div>
    </section>
  </div>
{% else %}
  <blog-posts-list section-id="{{ section.id }}">
    <div
      class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    ></div>
    <div
      class="
        section
        {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
        blog-posts
        spacing-style
        size-style
      "
      data-testid="blog-posts"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      {% content_for 'blocks' %}
      <div ref="grid" class="blog-posts-container">
        {% liquid
          assign items_on_page = blog.articles.size
        %}
        {% for article in blog.articles %}
          {% liquid
            assign col_span = 2
            assign scale = 0.6
            assign is_horizontal = false

            case items_on_page
              when 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              when 2
                assign col_span = 3
                assign scale = 0.8
              when 3
                if forloop.index == 1
                  assign col_span = 6
                  assign scale = 1
                  assign is_horizontal = true
                else
                  assign col_span = 3
                  assign scale = 0.8
                endif
              when 4
                assign col_span = 3
                assign scale = 0.8
              when 5
                if forloop.index == 1
                  assign col_span = 6
                  assign scale = 1
                  assign is_horizontal = true
                else
                  assign col_span = 3
                  assign scale = 0.8
                endif
              else
                if forloop.index == 1
                  assign col_span = 6
                  assign scale = 1
                  assign is_horizontal = true
                elsif forloop.index <= 3
                  assign col_span = 3
                  assign scale = 0.8
                else
                  assign col_span = 2
                  assign scale = 0.6
                endif
            endcase
          %}
          {% style %}
            [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
              --col-span: {{ col_span }};
              --blog-post-card-scale: {{ scale }};
            }

            @media screen and (max-width: 749px) {
              [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
                --col-span: 6;
                --blog-post-card-scale: 0.5;
              }
            }
          {% endstyle %}
          <div
            class="blog-post-item{% if is_horizontal %} blog-post-item--horizontal{% endif %}"
            data-testid="blog-post-item"
            data-blog-index="{{ section.id }}-{{ forloop.index }}"
          >
            {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
          </div>
        {% endfor %}
      </div>
    </div>
  </blog-posts-list>
{% endif %}

{% if is_journal %}
  <script>
    (() => {
      const setHeaderOffset = () => {
        const listing = document.querySelector('.journal-listing');
        if (!listing) return;
        const stickyCandidates = document.querySelectorAll('.announcement-bar, .sf2-header');
        let maxBottom = 0;
        stickyCandidates.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.bottom > maxBottom) maxBottom = rect.bottom;
        });
        listing.style.setProperty('--journal-header-offset', `${Math.ceil(maxBottom)}px`);
      };

      const initLoadMore = () => {
        const listing = document.querySelector('[data-journal-listing]');
        if (!listing) return;
        const grid = listing.querySelector('[data-journal-grid]');
        const loadMoreWrap = listing.querySelector('[data-journal-load-more-wrap]');
        const loadMoreButton = listing.querySelector('[data-journal-load-more]');
        if (!grid || !loadMoreWrap || !loadMoreButton) return;

        const loadNextPage = async () => {
          const nextUrl = loadMoreButton.getAttribute('data-next-url');
          if (!nextUrl) {
            loadMoreWrap.remove();
            return;
          }

          const loadingLabel = loadMoreButton.getAttribute('data-loading-label') || 'Loading...';
          const originalLabel = loadMoreButton.textContent;
          loadMoreButton.disabled = true;
          loadMoreButton.textContent = loadingLabel;

          try {
            const fetchUrl = new URL(nextUrl, window.location.origin);
            fetchUrl.searchParams.set('section_id', '{{ section.id }}');
            const response = await fetch(fetchUrl.toString(), { credentials: 'same-origin' });
            const html = await response.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const incomingGrid = doc.querySelector('[data-journal-grid]');
            const incomingButton = doc.querySelector('[data-journal-load-more]');
            if (!incomingGrid) throw new Error('Missing incoming grid');

            grid.insertAdjacentHTML('beforeend', incomingGrid.innerHTML);
            if (incomingButton) {
              const incomingNext = incomingButton.getAttribute('data-next-url');
              if (incomingNext) {
                loadMoreButton.setAttribute('data-next-url', incomingNext);
              } else {
                loadMoreWrap.remove();
              }
            } else {
              loadMoreWrap.remove();
            }
          } catch (error) {
            loadMoreButton.disabled = false;
            loadMoreButton.textContent = originalLabel;
            return;
          }

          if (document.body.contains(loadMoreButton)) {
            loadMoreButton.disabled = false;
            loadMoreButton.textContent = originalLabel;
          }
        };

        loadMoreButton.addEventListener('click', loadNextPage);
      };

      window.addEventListener('load', setHeaderOffset);
      window.addEventListener('resize', setHeaderOffset);
      setHeaderOffset();
      initLoadMore();
    })();
  </script>
{% endif %}

{% stylesheet %}
  .journal-listing {
    background: #f8f6f1;
    color: #101113;
  }

  .journal-listing__hero,
  .journal-listing__filters {
    background: #0a0b0d;
  }

  .journal-listing__hero-inner {
    padding-block: calc(var(--journal-header-offset, 140px) + 2.6rem) 2.75rem;
    text-align: center;
  }

  .journal-listing__eyebrow {
    color: #9de3fa;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    margin: 0 0 0.9rem;
    text-transform: uppercase;
  }

  .journal-listing__title {
    color: #fff;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
    margin: 0 0 1rem;
  }

  .journal-listing__intro {
    color: rgba(255, 255, 255, 0.72);
    margin: 0 auto;
    max-width: 38rem;
  }

  .journal-listing__filters .section {
    padding-block: 0 3rem;
  }

  .journal-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin: 0;
  }

  .journal-filter-bar__link {
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    color: #fff;
    font-size: 0.875rem;
    padding: 0.55rem 1.1rem;
    text-decoration: none;
  }

  .journal-filter-bar__link.is-active {
    background: #fff;
    color: #0a0b0d;
  }

  .journal-listing__feature {
    padding-block: 4.4rem 1.25rem;
  }

  .journal-feature {
    background: #fff;
    border: 1px solid rgba(16, 17, 19, 0.14);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    text-decoration: none;
  }

  .journal-feature__media {
    min-height: 23rem;
    position: relative;
  }

  .journal-feature__media img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .journal-feature__tag {
    background: #0ca7e0;
    color: #071117;
    font-size: 0.66rem;
    left: 1rem;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.65rem;
    position: absolute;
    text-transform: uppercase;
    top: 1rem;
  }

  .journal-feature__copy {
    align-self: center;
    padding: 2.6rem;
  }

  .journal-feature__eyebrow {
    color: #666b70;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  .journal-feature h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.1;
    margin: 0.8rem 0 1rem;
    text-transform: none;
  }

  .journal-feature p {
    color: #666b70;
    margin: 0;
  }

  .journal-feature__meta {
    align-items: center;
    display: flex;
    font-size: 0.75rem;
    gap: 0.7rem;
    margin-top: 1.2rem;
    text-transform: uppercase;
  }

  .journal-listing__grid-section {
    padding-block: 3.25rem 7rem;
  }

  .journal-listing__label {
    align-items: baseline;
    border-bottom: 1px solid rgba(16, 17, 19, 0.14);
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.8rem;
    padding-bottom: 1rem;
  }

  .journal-listing__label h3 {
    font-size: 1.8rem;
    margin: 0;
  }

  .journal-listing__label span {
    color: #666b70;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journal-listing__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .journal-card {
    background: #fff;
    border: 1px solid rgba(16, 17, 19, 0.14);
    color: inherit;
    text-decoration: none;
  }

  .journal-card__media {
    height: 14rem;
    position: relative;
  }

  .journal-card__media img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .journal-card__tag {
    background: #fff;
    color: #101113;
    font-size: 0.66rem;
    left: 0.9rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.55rem;
    position: absolute;
    text-transform: uppercase;
    top: 0.9rem;
  }

  .journal-card__body {
    padding: 1.2rem 1.2rem 1.3rem;
  }

  .journal-card__body h4 {
    font-size: 1.45rem;
    line-height: 1.1;
    margin: 0 0 0.65rem;
    text-transform: none;
  }

  .journal-card__body p {
    color: #666b70;
    margin: 0 0 0.65rem;
  }

  .journal-card__meta {
    font-size: 0.73rem;
    letter-spacing: 0.04em;
    margin: 0;
    text-transform: uppercase;
  }

  .journal-listing__load-more {
    display: flex;
    justify-content: center;
    margin-top: 2.4rem;
  }

  .journal-listing__load-more button {
    background: transparent;
    border: 1px solid #101113;
    color: #101113;
    cursor: pointer;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    padding: 0.8rem 1.6rem;
    text-transform: uppercase;
  }

  .journal-listing__load-more button:disabled {
    opacity: 0.65;
  }

  .journal-image-placeholder {
    align-items: center;
    background: #000;
    display: flex;
    height: 100%;
    justify-content: center;
    min-height: 100%;
    width: 100%;
  }

  .journal-image-placeholder img {
    display: block;
    max-width: 220px;
    width: 48%;
    object-fit: contain;
  }

  .journal-listing__signup {
    background: #0ca7e0;
    color: #071117;
    padding-block: 4.3rem;
  }

  .journal-listing__signup-grid {
    align-items: center;
    display: grid;
    gap: 1.8rem;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .journal-listing__signup-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.55rem;
    text-transform: uppercase;
  }

  .journal-listing__signup-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.05;
    margin: 0 0 0.45rem;
  }

  .journal-listing__signup-copy {
    margin: 0;
    max-width: 34rem;
  }

  .journal-listing__signup-form {
    display: flex;
    gap: 0.55rem;
  }

  .journal-listing__signup-form input {
    border: 1px solid #071117;
    min-height: 3rem;
    min-width: 16rem;
    padding: 0 0.9rem;
  }

  .journal-listing__signup-form button {
    background: #071117;
    border: 1px solid #071117;
    color: #fff;
    min-height: 3rem;
    padding: 0 1rem;
    text-transform: uppercase;
  }

  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  .blog-post-item {
    grid-column: span var(--col-span);
    background-color: var(--color-background);
  }

  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }

  @media screen and (max-width: 989px) {
    .journal-feature {
      grid-template-columns: 1fr;
    }

    .journal-feature__media {
      min-height: 18rem;
    }

    .journal-listing__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .journal-listing__hero-inner {
      padding-block: calc(var(--journal-header-offset, 110px) + 2rem) 2.4rem;
    }

    .journal-listing__filters .section {
      padding-block-end: 2.2rem;
    }

    .journal-filter-bar {
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 0.3rem;
      white-space: nowrap;
    }

    .journal-listing__grid {
      grid-template-columns: 1fr;
    }

    .journal-listing__signup-grid {
      grid-template-columns: 1fr;
    }

    .journal-listing__signup-form {
      flex-direction: column;
    }

    .journal-listing__signup-form input {
      min-width: 0;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
