

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign is_journal_tag_404 = false
  assign requested_tag_handle = ''
  assign requested_path_for_404 = request.path
  if requested_path_for_404 == blank or requested_path_for_404 == '/404'
    assign page_url = content_for_header | split: '"pageurl":"' | last | split: '"' | first | replace: '\/', '/' | replace: '%2F', '/' | replace: '%3A', ':'
    assign requested_path_for_404 = page_url | split: '/myshopify.com' | last
  endif
  if requested_path_for_404 contains '/blogs/journal/tagged/'
    assign requested_tag_handle = requested_path_for_404 | split: '/blogs/journal/tagged/' | last | split: '?' | first | split: '#' | first | split: '/' | first
    if requested_tag_handle != blank
      assign is_journal_tag_404 = true
    endif
  endif
%}

{% if is_journal_tag_404 %}
  {% assign requested_tag_label = requested_tag_handle | replace: '-', ' ' | replace: '_', ' ' %}
  {% assign journal_tags = 'Recipes:recipes|Estate News:estate-news|Media:media|Winemaker Notes:winemaker-notes' | split: '|' %}
  {% for tag_pair in journal_tags %}
    {% assign pair = tag_pair | split: ':' %}
    {% assign tag_label = pair[0] %}
    {% assign tag_handle = pair[1] %}
    {% if tag_handle == requested_tag_handle %}
      {% assign requested_tag_label = tag_label %}
      {% break %}
    {% endif %}
  {% endfor %}
  <div class="journal-listing journal-listing--empty-state">
    {% render 'journal-listing-header',
      active_tag_label: requested_tag_label,
      active_tag_handle: requested_tag_handle,
      blog_url: '/blogs/journal'
    %}

    <section class="journal-listing__empty">
      <div class="section">
        <div class="journal-listing__empty-card">
          <h2>No stories tagged "{{ requested_tag_label }}" yet.</h2>
          <p>Check back soon for new Journal updates in this category.</p>
        </div>
      </div>
    </section>
  </div>

  <script>
    (() => {
      const listing = document.querySelector('.journal-listing--empty-state');
      if (!listing) return;
      const setHeaderOffset = () => {
        const stickyCandidates = document.querySelectorAll('.announcement-bar, .sf2-header');
        let maxBottom = 0;
        stickyCandidates.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.bottom > maxBottom) maxBottom = rect.bottom;
        });
        listing.style.setProperty('--journal-header-offset', `${Math.ceil(maxBottom)}px`);
      };
      window.addEventListener('load', setHeaderOffset);
      window.addEventListener('resize', setHeaderOffset);
      setHeaderOffset();
    })();
  </script>
{% else %}
<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}
    {% if section.settings.section_height != "" %} {{ section.settings.section_height | prepend: "section--height-" }}{% endif %}
  "
>
  <div>
    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--column
        section-content-wrapper
        mobile-column
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
{% endif %}

{% stylesheet %}
  .journal-listing--empty-state {
    background: #f8f6f1;
    color: #101113;
  }

  .journal-listing__hero,
  .journal-listing__filters {
    background: #0a0b0d;
  }

  .journal-listing__hero-inner {
    padding-block: calc(var(--journal-header-offset, 140px) + 2.6rem) 2.75rem;
    text-align: center;
  }

  .journal-listing__eyebrow {
    color: #9de3fa;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    margin: 0 0 0.9rem;
    text-transform: uppercase;
  }

  .journal-listing__title {
    color: #fff;
    font-family: "Libre Caslon Display", serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
    margin: 0 0 1rem;
  }

  .journal-listing__intro {
    color: rgba(255, 255, 255, 0.72);
    margin: 0 auto;
    max-width: 38rem;
  }

  .journal-listing__filters .section {
    padding-block: 0 3rem;
  }

  .journal-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin: 0;
  }

  .journal-filter-bar__link {
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    color: #fff;
    font-size: 0.875rem;
    padding: 0.55rem 1.1rem;
    text-decoration: none;
  }

  .journal-filter-bar__link.is-active {
    background: #fff;
    color: #0a0b0d;
  }

  .journal-listing__empty {
    padding: 3.2rem 0 5.5rem;
  }

  .journal-listing__empty-card {
    background: #fff;
    border: 1px solid rgba(16, 17, 19, 0.14);
    margin: 0 auto;
    max-width: 760px;
    padding: 2.4rem;
    text-align: center;
  }

  .journal-listing__empty-card h2 {
    font-family: "Libre Caslon Display", serif;
    font-size: 2rem;
    margin: 0 0 0.8rem;
    text-transform: none;
  }

  .journal-listing__empty-card p {
    color: #666b70;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .journal-listing__hero-inner {
      padding-block: calc(var(--journal-header-offset, 110px) + 2rem) 2.4rem;
    }

    .journal-filter-bar {
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 0.3rem;
      white-space: nowrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.404",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.horizontal_alignment_flex_direction_column == 'fake-value' }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
