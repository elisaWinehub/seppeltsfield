

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign is_journal_article = false
  if article.blog.handle == 'journal'
    assign is_journal_article = true
  endif
  assign article_word_count = article.content | strip_html | split: ' ' | size
  assign article_read_time = article_word_count | divided_by: 220
  if article_read_time < 1
    assign article_read_time = 1
  endif
%}

{% if is_journal_article %}
  <div class="journal-article">
    <nav class="journal-article__crumb">
      <div class="journal-article__read">
        <a href="{{ article.blog.url }}">{{ article.blog.title }}</a>
        {% if article.tags.size > 0 %}
          <span>/</span>
          <a href="{{ article.blog.url }}/tagged/{{ article.tags.first | handleize }}">{{ article.tags.first }}</a>
        {% endif %}
      </div>
    </nav>

    <header class="journal-article__head">
      <div class="journal-article__read">
        {% if article.tags.size > 0 %}
          <p class="journal-article__tag">{{ article.tags.first }}</p>
        {% endif %}
        <h1>{{ article.title }}</h1>
        <p class="journal-article__dek">{{ article.excerpt_or_content | strip_html | truncate: 220 }}</p>
        <div class="journal-article__byline">
          <div class="journal-article__avatar">{{ article.author | slice: 0 }}</div>
          <div class="journal-article__who">
            <strong>{{ article.author }}</strong>
            <span>{{ article.published_at | date: '%d %B %Y' }}</span>
          </div>
          <p class="journal-article__meta">{{ article_read_time }} min read</p>
        </div>
      </div>
    </header>

    {% if article.image %}
      <div class="journal-article__hero">
        {{ article.image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: article.title }}
      </div>
    {% endif %}

    <div class="journal-article__body">
      <div class="journal-article__read rte">
        {{ article.content }}
      </div>
    </div>

    <div class="journal-article__share-wrap">
      <div class="journal-article__read journal-article__share">
        {% assign share_url = shop.secure_url | append: article.url %}
        <span>Share</span>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener">f</a>
        <a href="https://x.com/intent/tweet?url={{ share_url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener">x</a>
        <a href="mailto:?subject={{ article.title | url_encode }}&body={{ share_url | url_encode }}">@</a>
      </div>
    </div>

    <section class="journal-article__related">
      <div class="section">
        <div class="journal-article__related-head">
          <h2>More from the Journal</h2>
          <a href="{{ article.blog.url }}">View all</a>
        </div>
        <div class="journal-article__related-grid">
          {% assign related_count = 0 %}
          {% for related_article in article.blog.articles %}
            {% if related_article.id != article.id and related_count < 3 %}
              {% assign related_count = related_count | plus: 1 %}
              <a class="journal-article__related-card" href="{{ related_article.url }}">
                <div class="journal-article__related-media">
                  {% if related_article.image %}
                    {{ related_article.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: related_article.title }}
                  {% endif %}
                  {% if related_article.tags.size > 0 %}
                    <span>{{ related_article.tags.first }}</span>
                  {% endif %}
                </div>
                <div class="journal-article__related-copy">
                  <h3>{{ related_article.title }}</h3>
                  <p>{{ related_article.published_at | date: '%d %b %Y' }}</p>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  </div>
{% else %}
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div class="section{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--column
        section-content-wrapper
        mobile-column
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      {% content_for 'blocks' %}

      {% if blog.comments_enabled? %}
        <div class="blog-post-comments-container">
          <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

          <div class="blog-post-comments">
            {% paginate article.comments by 10 %}
              {% for comment in article.comments %}
                <div class="blog-post-comment">
                  {{ comment.content }}
                  <div class="blog-post-comment__author">
                    <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                    <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                    <span class="blog-post-comment__date">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </div>
                </div>
              {% endfor %}

              <div class="blog-post-comments-pagination">
                {{- paginate | default_pagination -}}
              </div>
            {% endpaginate %}
          </div>

          {% render 'blog-comment-form', article: article, section_id: section.id %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  .journal-article {
    background: #f8f6f1;
    color: #101113;
    padding-bottom: 6rem;
  }

  .journal-article__read {
    margin: 0 auto;
    max-width: 760px;
    width: min(calc(100% - 48px), 760px);
  }

  .journal-article__crumb {
    padding-top: 1.4rem;
  }

  .journal-article__crumb .journal-article__read {
    color: #666b70;
    display: flex;
    font-size: 0.72rem;
    gap: 0.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .journal-article__head {
    padding: 1.8rem 0 2.4rem;
  }

  .journal-article__tag {
    background: #0ca7e0;
    color: #071117;
    display: inline-block;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    margin: 0 0 0.9rem;
    padding: 0.35rem 0.65rem;
    text-transform: uppercase;
  }

  .journal-article__head h1 {
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1.05;
    margin: 0 0 0.9rem;
  }

  .journal-article__dek {
    color: #666b70;
    font-size: 1.02rem;
    margin: 0 0 1.3rem;
  }

  .journal-article__byline {
    align-items: center;
    border-bottom: 1px solid rgba(16, 17, 19, 0.14);
    border-top: 1px solid rgba(16, 17, 19, 0.14);
    display: flex;
    gap: 0.75rem;
    padding: 1rem 0;
  }

  .journal-article__avatar {
    align-items: center;
    background: #101113;
    border-radius: 999px;
    color: #fff;
    display: flex;
    font-size: 0.95rem;
    height: 2.35rem;
    justify-content: center;
    text-transform: uppercase;
    width: 2.35rem;
  }

  .journal-article__who strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .journal-article__who span {
    color: #666b70;
    display: block;
    font-size: 0.76rem;
  }

  .journal-article__meta {
    color: #666b70;
    font-size: 0.75rem;
    margin: 0 0 0 auto;
    text-transform: uppercase;
  }

  .journal-article__hero {
    background: #fff;
    max-height: 640px;
    min-height: 320px;
    overflow: hidden;
  }

  .journal-article__hero img {
    display: block;
    height: min(56vh, 640px);
    min-height: 320px;
    object-fit: cover;
    width: 100%;
  }

  .journal-article__body {
    padding-top: 3.5rem;
  }

  .journal-article__body .rte p {
    color: #2b2d30;
  }

  .journal-article__share-wrap {
    margin-top: 2.2rem;
  }

  .journal-article__share {
    align-items: center;
    border-top: 1px solid rgba(16, 17, 19, 0.14);
    display: flex;
    gap: 0.8rem;
    padding-top: 1.3rem;
  }

  .journal-article__share span {
    color: #666b70;
    font-size: 0.73rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .journal-article__share a {
    align-items: center;
    border: 1px solid rgba(16, 17, 19, 0.2);
    border-radius: 999px;
    color: #101113;
    display: flex;
    height: 2.1rem;
    justify-content: center;
    text-decoration: none;
    width: 2.1rem;
  }

  .journal-article__related {
    border-top: 1px solid rgba(16, 17, 19, 0.14);
    margin-top: 4rem;
    padding-top: 3.2rem;
  }

  .journal-article__related-head {
    align-items: baseline;
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.4rem;
  }

  .journal-article__related-head h2 {
    font-size: 1.9rem;
    margin: 0;
  }

  .journal-article__related-head a {
    border-bottom: 1px solid currentColor;
    color: #101113;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .journal-article__related-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .journal-article__related-card {
    background: #fff;
    border: 1px solid rgba(16, 17, 19, 0.14);
    color: inherit;
    text-decoration: none;
  }

  .journal-article__related-media {
    height: 12.75rem;
    position: relative;
  }

  .journal-article__related-media img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .journal-article__related-media span {
    background: #fff;
    color: #101113;
    font-size: 0.66rem;
    left: 0.9rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.55rem;
    position: absolute;
    text-transform: uppercase;
    top: 0.9rem;
  }

  .journal-article__related-copy {
    padding: 1rem 1rem 1.2rem;
  }

  .journal-article__related-copy h3 {
    font-size: 1.3rem;
    line-height: 1.1;
    margin: 0 0 0.45rem;
  }

  .journal-article__related-copy p {
    color: #666b70;
    font-size: 0.76rem;
    margin: 0;
    text-transform: uppercase;
  }

  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }

  @media screen and (max-width: 989px) {
    .journal-article__related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .journal-article__read {
      width: min(calc(100% - 28px), 760px);
    }

    .journal-article__byline {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .journal-article__meta {
      margin: 0;
      width: 100%;
    }

    .journal-article__related-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_blog-post-title"
    },
    {
      "type": "_blog-post-info-text"
    },
    {
      "type": "_blog-post-featured-image"
    },
    {
      "type": "_blog-post-content"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
