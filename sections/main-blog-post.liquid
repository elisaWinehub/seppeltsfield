

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign is_journal_article = false
  if blog.handle == 'journal'
    assign is_journal_article = true
  elsif article.url contains '/blogs/journal/'
    assign is_journal_article = true
  endif
  assign article_word_count = article.content | strip_html | split: ' ' | size
  assign article_read_time = article_word_count | divided_by: 220
  assign journal_source_blog = article.blog
  if blogs['journal'] and blogs['journal'].articles_count > 0
    assign journal_source_blog = blogs['journal']
  endif
  if article_read_time < 1
    assign article_read_time = 1
  endif
%}

{% if is_journal_article %}
  <div class="journal-article">
    <div class="journal-article__hero-wrap">
      <div class="journal-article__hero">
        {% if article.image %}
          {{ article.image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: article.title }}
        {% else %}
          <div class="journal-image-placeholder journal-image-placeholder--hero" aria-hidden="true">
            {% if settings.logo_inverse != blank %}
              {{ settings.logo_inverse | image_url: width: 500 | image_tag: widths: '260,380,500', sizes: '260px', alt: shop.name, loading: 'lazy' }}
            {% elsif settings.logo != blank %}
              {{ settings.logo | image_url: width: 500 | image_tag: widths: '260,380,500', sizes: '260px', alt: shop.name, loading: 'lazy' }}
            {% else %}
              <img src="https://cdn.shopify.com/s/files/1/0780/2608/0408/files/Seppeltsfield-logo_Est1851_HERO_no_Background.png?v=1783903221" alt="{{ shop.name | escape }}" loading="lazy">
            {% endif %}
          </div>
        {% endif %}
        <div class="journal-article__hero-overlay">
          <div class="journal-article__read">
            <header class="journal-article__head">
              {% if article.tags.size > 0 %}
                <p class="journal-article__tag">{{ article.tags.first }}</p>
              {% endif %}
              <h1>{{ article.title }}</h1>
              <div class="journal-article__byline">
                <div class="journal-article__avatar">{{ article.author | slice: 0 }}</div>
                <div class="journal-article__who">
                  <strong>{{ article.author }}</strong>
                  <span>{{ article.published_at | date: '%d %B %Y' }}</span>
                </div>
                <p class="journal-article__meta">{{ article_read_time }} min read</p>
              </div>
            </header>
          </div>
        </div>
      </div>
    </div>

    <div class="journal-article__content section">
      <div class="journal-article__content-grid">
        <div class="journal-article__main">
          <div class="journal-article__body">
            <div class="journal-article__read rte">
              {{ article.content }}
            </div>
          </div>
          <div class="journal-article__share-wrap">
            <div class="journal-article__read journal-article__share">
              {% assign share_url = shop.secure_url | append: article.url %}
              <span>Share</span>
              <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener">f</a>
              <a href="https://x.com/intent/tweet?url={{ share_url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener">x</a>
              <button type="button" data-copy-link data-link="{{ share_url }}" data-default-label="⎘" data-success-label="✓" aria-label="Copy article link">⎘</button>
            </div>
          </div>
          <div class="journal-article__read journal-article__author-card">
            <div class="journal-article__author-avatar">{{ article.author | slice: 0 }}</div>
            <div>
              <p class="journal-article__author-name">{{ article.author }}</p>
              <p class="journal-article__author-bio">Contributor to the Seppeltsfield Journal.</p>
            </div>
          </div>
        </div>
        <aside class="journal-article__sidebar" aria-label="Other journal articles">
          <h2>More Journal stories</h2>
          <ul>
            {% assign sidebar_count = 0 %}
            {% for sidebar_article in journal_source_blog.articles %}
              {% if sidebar_article.id != article.id and sidebar_count < 8 %}
                {% assign sidebar_count = sidebar_count | plus: 1 %}
                <li>
                  <a href="{{ sidebar_article.url }}">
                    <span class="journal-article__sidebar-media">
                      {% if sidebar_article.image %}
                        {{ sidebar_article.image | image_url: width: 560 | image_tag: loading: 'lazy', alt: sidebar_article.title }}
                      {% else %}
                        <span class="journal-image-placeholder journal-image-placeholder--sidebar" aria-hidden="true">
                          {% if settings.logo_inverse != blank %}
                            {{ settings.logo_inverse | image_url: width: 220 | image_tag: widths: '160,220', sizes: '(min-width: 990px) 280px, 100vw', alt: shop.name, loading: 'lazy' }}
                          {% elsif settings.logo != blank %}
                            {{ settings.logo | image_url: width: 220 | image_tag: widths: '160,220', sizes: '(min-width: 990px) 280px, 100vw', alt: shop.name, loading: 'lazy' }}
                          {% else %}
                            <img src="https://cdn.shopify.com/s/files/1/0780/2608/0408/files/Seppeltsfield-logo_Est1851_HERO_no_Background.png?v=1783903221" alt="{{ shop.name | escape }}" loading="lazy">
                          {% endif %}
                        </span>
                      {% endif %}
                    </span>
                    <span class="journal-article__sidebar-title">{{ sidebar_article.title }}</span>
                    <span class="journal-article__sidebar-date">{{ sidebar_article.published_at | date: '%d %b %Y' }}</span>
                  </a>
                </li>
              {% endif %}
            {% endfor %}
            {% if sidebar_count == 0 %}
              <li>
                <span class="journal-article__sidebar-date">No additional stories yet.</span>
              </li>
            {% endif %}
          </ul>
        </aside>
      </div>
    </div>
  </div>
{% else %}
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div class="section{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--column
        section-content-wrapper
        mobile-column
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      {% content_for 'blocks' %}

      {% if blog.comments_enabled? %}
        <div class="blog-post-comments-container">
          <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

          <div class="blog-post-comments">
            {% paginate article.comments by 10 %}
              {% for comment in article.comments %}
                <div class="blog-post-comment">
                  {{ comment.content }}
                  <div class="blog-post-comment__author">
                    <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                    <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                    <span class="blog-post-comment__date">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </div>
                </div>
              {% endfor %}

              <div class="blog-post-comments-pagination">
                {{- paginate | default_pagination -}}
              </div>
            {% endpaginate %}
          </div>

          {% render 'blog-comment-form', article: article, section_id: section.id %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% if is_journal_article %}
  <script>
    (() => {
      const root = document.querySelector('.journal-article');
      if (!root) return;
      const hero = root.querySelector('.journal-article__hero');
      let solidThreshold = 96;
      const getHeaderNodes = () => {
        const header = document.querySelector('[data-sf2-header]');
        const headerGroup = document.querySelector('#header-group');
        const headerNav = header ? header.querySelector('.sf2-header__nav') : document.querySelector('.sf2-header__nav');
        const headerSection =
          (header && header.closest('.shopify-section.sf2-header-section')) ||
          document.querySelector('.shopify-section.sf2-header-section');
        return { header, headerGroup, headerNav, headerSection };
      };

      const setHeaderBackground = (background) => {
        const { header, headerGroup, headerNav, headerSection } = getHeaderNodes();
        if (background == 'transparent') {
          if (headerGroup) {
            headerGroup.style.removeProperty('background-color');
          }
          if (headerSection) {
            headerSection.style.removeProperty('background-color');
          }
          if (header) {
            header.style.removeProperty('background-color');
          }
          if (headerNav) {
            headerNav.style.removeProperty('background-color');
          }
          return;
        }

        [headerSection, headerGroup, header, headerNav].forEach((node) => {
          if (node) node.style.setProperty('background-color', background, 'important');
        });
      };

      const applyHeaderTransition = () => {
        const { header, headerGroup, headerNav, headerSection } = getHeaderNodes();
        [headerSection, headerGroup, header, headerNav].forEach((node) => {
          if (node) node.style.setProperty('transition', 'background-color 180ms ease');
        });
      };

      const setSolidThreshold = () => {
        const { header } = getHeaderNodes();
        const headerHeight = header ? Math.ceil(header.getBoundingClientRect().height) : 0;
        const heroHeight = hero ? Math.ceil(hero.getBoundingClientRect().height) : 0;
        const heroBasedThreshold = heroHeight > 0 ? Math.max(0, heroHeight - headerHeight) : 0;
        solidThreshold = Math.max(96, heroBasedThreshold);
      };

      const forceTransparentHeader = () => {
        document.documentElement.classList.add('sf2-journal-article-transparent-header');
        const { header, headerGroup } = getHeaderNodes();
        if (header) {
          header.classList.add('sf2-header--transparent');
        }
        if (headerGroup) {
          headerGroup.classList.remove('is-scrolled');
          headerGroup.classList.remove('has-scrolled-header');
        }
        setHeaderBackground('transparent');
      };

      const setHeaderOffset = () => {
        const stickyCandidates = document.querySelectorAll('.announcement-bar, .sf2-header');
        let maxBottom = 0;
        stickyCandidates.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.bottom > maxBottom) maxBottom = rect.bottom;
        });
        root.style.setProperty('--journal-header-offset', `${Math.ceil(maxBottom)}px`);
      };

      const syncScrolledHeaderState = () => {
        const hasScrolled = window.scrollY > 0;
        const { header, headerGroup, headerSection } = getHeaderNodes();
        document.documentElement.classList.toggle('sf2-journal-article-header-scrolled', hasScrolled);
        if (header) {
          if (hasScrolled) {
            header.classList.remove('sf2-header--transparent');
          } else {
            header.classList.add('sf2-header--transparent');
          }
        }
        if (headerGroup) {
          headerGroup.classList.toggle('is-scrolled', hasScrolled);
          headerGroup.classList.toggle('has-scrolled-header', hasScrolled);
        }
        if (headerSection) {
          headerSection.classList.toggle('sf2-journal-header-scrolled', hasScrolled);
        }
        setHeaderBackground(hasScrolled ? '#000' : 'transparent');
      };

      const initCopyLink = () => {
        const button = root.querySelector('[data-copy-link]');
        if (!button) return;
        button.addEventListener('click', async () => {
          const link = button.getAttribute('data-link') || window.location.href;
          const successLabel = button.getAttribute('data-success-label') || 'Copied';
          const defaultLabel = button.getAttribute('data-default-label') || 'Copy';
          try {
            await navigator.clipboard.writeText(link);
            button.textContent = successLabel;
            button.classList.add('is-copied');
            window.setTimeout(() => {
              button.textContent = defaultLabel;
              button.classList.remove('is-copied');
            }, 1800);
          } catch (error) {}
        });
      };

      window.addEventListener('load', setHeaderOffset);
      window.addEventListener('resize', setHeaderOffset);
      window.addEventListener('resize', setSolidThreshold);
      window.addEventListener('load', syncScrolledHeaderState);
      window.addEventListener('scroll', syncScrolledHeaderState, { passive: true });
      applyHeaderTransition();
      forceTransparentHeader();
      setSolidThreshold();
      setHeaderOffset();
      syncScrolledHeaderState();
      initCopyLink();
    })();
  </script>
{% endif %}

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  .journal-article {
    background: #f8f6f1;
    color: #101113;
    padding-bottom: 6rem;
  }

  .journal-article__read {
    margin: 0 auto;
    max-width: 760px;
    width: min(calc(100% - 48px), 760px);
  }

  .journal-article__crumb {
    margin: 0 0 1rem;
    padding-top: 0;
  }

  .journal-article__crumb .journal-article__read {
    color: #666b70;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.72rem;
    gap: 0.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    width: 100%;
  }

  .journal-article__crumb a {
    color: inherit;
    text-decoration: none;
  }

  .journal-article__head {
    padding: 0;
  }

  .journal-article__hero-wrap {
    margin-top: 0;
    padding-top: 0;
  }

  .journal-article__tag {
    background: #0ca7e0;
    color: #071117;
    display: block;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    margin: 0 auto 0.9rem;
    padding: 0.35rem 0.65rem;
    text-transform: uppercase;
    width: fit-content;
  }

  .journal-article__head h1 {
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1.05;
    margin: 0 0 0.9rem;
    text-align: center;
    text-transform: none;
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    word-break: normal;
  }

  .journal-article__dek {
    color: #666b70;
    font-size: 1.02rem;
    margin: 0 0 1.3rem;
  }

  .journal-article__byline {
    align-items: center;
    border-bottom: 1px solid rgba(16, 17, 19, 0.14);
    border-top: 1px solid rgba(16, 17, 19, 0.14);
    display: flex;
    gap: 0.75rem;
    padding: 1rem 0;
  }

  .journal-article__avatar {
    align-items: center;
    background: #101113;
    border-radius: 999px;
    color: #fff;
    display: flex;
    font-size: 0.95rem;
    height: 2.35rem;
    justify-content: center;
    text-transform: uppercase;
    width: 2.35rem;
  }

  .journal-article__who strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .journal-article__who span {
    color: #666b70;
    display: block;
    font-size: 0.76rem;
  }

  .journal-article__meta {
    color: #666b70;
    font-size: 0.75rem;
    margin: 0 0 0 auto;
    text-transform: uppercase;
  }

  .journal-article__hero {
    background: #000;
    max-height: 640px;
    min-height: 600px;
    overflow: hidden;
    padding-top: 0;
    position: relative;
  }

  .journal-article__hero img {
    display: block;
    height: 600px;
    min-height: 320px;
    object-fit: cover;
    width: 100%;
  }

  .journal-article__hero-overlay {
    align-items: end;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.76), rgba(0, 0, 0, 0.22) 52%, rgba(0, 0, 0, 0));
    bottom: 0;
    color: #fff;
    display: flex;
    left: 0;
    padding: 2rem 0 2.5rem;
    position: absolute;
    right: 0;
    top: 0;
  }

  .journal-article__hero-overlay h1,
  .journal-article__hero-overlay .journal-article__who strong {
    color: #fff;
  }

  .journal-article__hero-overlay .journal-article__dek,
  .journal-article__hero-overlay .journal-article__who span,
  .journal-article__hero-overlay .journal-article__meta {
    color: rgba(255, 255, 255, 0.86);
  }

  .journal-article__hero-overlay .journal-article__byline {
    border-bottom-color: rgba(255, 255, 255, 0.3);
    border-top-color: rgba(255, 255, 255, 0.3);
  }

  .journal-article__content {
    margin-top: 2.8rem;
  }

  .journal-article__content-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) 280px;
  }

  .journal-article__sidebar {
    align-self: start;
    border-left: 1px solid rgba(16, 17, 19, 0.14);
    padding-left: 1.25rem;
    position: sticky;
    top: calc(var(--journal-header-offset, 140px) + 1rem);
  }

  .journal-article__sidebar h2 {
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    margin: 0 0 0.85rem;
    text-transform: none;
  }

  .journal-article__sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .journal-article__sidebar li + li {
    border-top: 1px solid rgba(16, 17, 19, 0.14);
    margin-top: 0.8rem;
    padding-top: 0.8rem;
  }

  .journal-article__sidebar a {
    color: inherit;
    display: block;
    text-decoration: none;
  }

  .journal-article__sidebar-media {
    aspect-ratio: 16 / 9;
    display: block;
    margin-bottom: 0.65rem;
    overflow: hidden;
    width: 100%;
  }

  .journal-article__sidebar-media img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .journal-article__sidebar-title {
    display: block;
    font-size: 0.95rem;
    line-height: 1.25;
    margin-bottom: 0.25rem;
    text-transform: none;
  }

  .journal-article__sidebar-date {
    color: #666b70;
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .journal-article__body {
    padding-top: 0;
  }

  .journal-article__body .rte p {
    color: #2b2d30;
  }

  .journal-article__body .rte img {
    display: block;
    height: auto;
    margin: 2rem auto;
    max-width: 100%;
  }

  .journal-article__body .rte figure {
    margin: 2rem auto;
  }

  .journal-article__body .rte figcaption {
    color: #666b70;
    font-size: 0.78rem;
    margin-top: 0.5rem;
  }

  .journal-article__share-wrap {
    margin-top: 2.2rem;
  }

  .journal-article__share {
    align-items: center;
    border-top: 1px solid rgba(16, 17, 19, 0.14);
    display: flex;
    gap: 0.8rem;
    padding-top: 1.3rem;
  }

  .journal-article__share span {
    color: #666b70;
    font-size: 0.73rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .journal-article__share a {
    align-items: center;
    border: 1px solid rgba(16, 17, 19, 0.2);
    border-radius: 999px;
    color: #101113;
    display: flex;
    height: 2.1rem;
    justify-content: center;
    text-decoration: none;
    width: 2.1rem;
  }

  .journal-article__share button {
    align-items: center;
    background: transparent;
    border: 1px solid rgba(16, 17, 19, 0.2);
    border-radius: 999px;
    color: #101113;
    cursor: pointer;
    display: flex;
    height: 2.1rem;
    justify-content: center;
    width: 2.1rem;
  }

  .journal-article__share button.is-copied {
    background: #101113;
    color: #fff;
  }

  .journal-article__author-card {
    align-items: center;
    background: #fff;
    border: 1px solid rgba(16, 17, 19, 0.14);
    display: grid;
    gap: 0.85rem;
    grid-template-columns: auto 1fr;
    margin-top: 2.2rem;
    padding: 1.2rem;
  }

  .journal-article__author-avatar {
    align-items: center;
    background: #101113;
    border-radius: 999px;
    color: #fff;
    display: flex;
    height: 2.6rem;
    justify-content: center;
    width: 2.6rem;
  }

  .journal-article__author-name {
    font-size: 0.95rem;
    margin: 0 0 0.2rem;
  }

  .journal-article__author-bio {
    color: #666b70;
    margin: 0;
  }

  .journal-image-placeholder {
    align-items: center;
    background: #000;
    display: flex;
    height: 100%;
    justify-content: center;
    width: 100%;
  }

  .journal-image-placeholder img {
    display: block;
    max-width: 240px;
    object-fit: contain;
    width: 48%;
  }

  .journal-image-placeholder--hero img {
    max-width: 300px;
  }

  .journal-image-placeholder--sidebar img {
    max-width: 150px;
    width: 52%;
  }

  .sf2-journal-article-transparent-header #header-group .sf2-header,
  .sf2-journal-article-transparent-header #header-group .sf2-header__nav {
    background-color: transparent !important;
  }

  .sf2-journal-article-header-scrolled .shopify-section.sf2-header-section,
  .sf2-journal-article-header-scrolled #header-group,
  .sf2-journal-article-header-scrolled #header-group.is-scrolled,
  .sf2-journal-article-header-scrolled #header-group .sf2-header,
  .sf2-journal-article-header-scrolled #header-group .sf2-header__nav {
    background-color: #000 !important;
  }

  .shopify-section.sf2-header-section.sf2-journal-header-scrolled,
  .shopify-section.sf2-header-section.sf2-journal-header-scrolled .sf2-header,
  .shopify-section.sf2-header-section.sf2-journal-header-scrolled .sf2-header__nav {
    background-color: #000 !important;
  }

  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }

  @media screen and (max-width: 989px) {
    .journal-article__content-grid {
      grid-template-columns: 1fr;
    }

    .journal-article__sidebar {
      border-left: 0;
      border-top: 1px solid rgba(16, 17, 19, 0.14);
      padding-left: 0;
      padding-top: 1.1rem;
      position: static;
      top: auto;
    }

  }

  @media screen and (max-width: 749px) {
    .journal-article__read {
      width: min(calc(100% - 28px), 760px);
    }

    .journal-article__byline {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .journal-article__meta {
      margin: 0;
      width: 100%;
    }

    .journal-article__hero-wrap {
      padding-top: 0;
    }

    .journal-article__author-card {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
